<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while Flutter starts. Matches the Flutter splash: forest with the
     paper branch mark, so launch does not flash a different colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/rumpun_forest" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>

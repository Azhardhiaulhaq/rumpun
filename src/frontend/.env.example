# Copy to .env and fill in. Never commit .env: it is gitignored.
#
#   flutter run --dart-define-from-file=.env
#
# These are compile-time values, so a change only takes effect on the next
# build, not on hot reload.

# Web client ID from Google Cloud Console. The backend checks the ID token's
# `aud` against this exact value, so the Android and iOS client IDs will not
# work here.
RUMPUN_GOOGLE_CLIENT_ID=
RUMPUN_GOOGLE_IOS_CLIENT_ID=

# Where the app looks for the API, including the /api/v1 prefix.
# Android emulator reaching the host:  http://10.0.2.2:8000/api/v1
# iOS simulator or desktop:            http://localhost:8000/api/v1
# Physical phone via a tunnel:         https://<subdomain>.ngrok-free.dev/api/v1
RUMPUN_API_BASE_URL=http://10.0.2.2:8000/api/v1

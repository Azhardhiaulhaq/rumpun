# Copy to deploy/.env.production on the server. Never commit the real file.
RUMPUN_ENVIRONMENT=production
RUMPUN_DATABASE_URL=postgresql+psycopg://rumpun:CHANGE_ME@127.0.0.1:5433/rumpun
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
RUMPUN_JWT_SECRET=
RUMPUN_ACCESS_TOKEN_MINUTES=15
RUMPUN_REFRESH_TOKEN_DAYS=30
RUMPUN_GOOGLE_CLIENT_ID=
RUMPUN_GMAIL_OAUTH_CLIENT_ID=
RUMPUN_GMAIL_OAUTH_CLIENT_SECRET=
RUMPUN_GMAIL_OAUTH_REDIRECT_URI=https://azhar2.liber.id/api/v1/gmail/oauth/callback
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RUMPUN_GMAIL_TOKEN_KEY=
RUMPUN_GMAIL_SYNC_MINUTES=30
RUMPUN_JEV_API_KEY=
RUMPUN_FIREBASE_PROJECT_ID=rumpun-app
GOOGLE_APPLICATION_CREDENTIALS=/firebase-credentials/service-account.json
RUMPUN_RATE_LIMIT_ATTEMPTS=10
RUMPUN_RATE_LIMIT_WINDOW_SECONDS=60
RUMPUN_INBOUND_EMAIL_DOMAIN=invalid.example
RUMPUN_INBOUND_WEBHOOK_SECRET=

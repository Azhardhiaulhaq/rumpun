RUMPUN_ENVIRONMENT=development
RUMPUN_DATABASE_URL=postgresql+psycopg://rumpun:rumpun@db:5432/rumpun
RUMPUN_JWT_SECRET=replace-with-at-least-32-random-characters
RUMPUN_ACCESS_TOKEN_MINUTES=15
RUMPUN_REFRESH_TOKEN_DAYS=30
RUMPUN_GOOGLE_CLIENT_ID=
RUMPUN_GMAIL_OAUTH_CLIENT_ID=
RUMPUN_GMAIL_OAUTH_CLIENT_SECRET=
# Existing HTTPS backend URL; Google redirects here after consent.
RUMPUN_GMAIL_OAUTH_REDIRECT_URI=https://your-api.example.com/api/v1/gmail/oauth/callback
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RUMPUN_GMAIL_TOKEN_KEY=
RUMPUN_GMAIL_SYNC_MINUTES=30
# Until this is set, Gmail message IDs wait without being classified.
RUMPUN_JEV_API_KEY=
# Firebase project ID and Application Default Credentials for the push worker.
RUMPUN_FIREBASE_PROJECT_ID=rumpun-app
# For local Docker: mount a credentials directory and set the path inside the container.
RUMPUN_GOOGLE_CREDENTIALS_DIR=/path/to/credentials-directory
GOOGLE_APPLICATION_CREDENTIALS=/firebase-credentials/service-account.json
RUMPUN_RATE_LIMIT_ATTEMPTS=10
RUMPUN_RATE_LIMIT_WINDOW_SECONDS=60

# Host port for the API. Change it when another local service holds 8000.
RUMPUN_API_PORT=8000

# Inbound transaction email. Without the webhook secret the endpoint is
# disabled rather than open. See docs/email-forwarding-setup.md.
# A domain you own, with Cloudflare Email Routing enabled on it.
RUMPUN_INBOUND_EMAIL_DOMAIN=mail.example.com
RUMPUN_INBOUND_WEBHOOK_SECRET=
